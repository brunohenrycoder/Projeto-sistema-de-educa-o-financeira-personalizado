DB_URL=jdbc:postgresql://localhost:5432/aurora
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-database-password

# Configure a random value of at least 32 UTF-8 bytes; do not reuse this placeholder.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=86400000

# React + Vite development origin and browser-facing links.
CORS_ALLOWED_ORIGINS=http://localhost:5173
EMAIL_CONFIRMATION_URL=http://localhost:5173/confirm-email
FAMILY_INVITE_URL=http://localhost:5173/family-invite

# SMTP settings. localhost:1025 is only a local mail-catcher default.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL=false
SMTP_CONNECTION_TIMEOUT=5000
SMTP_TIMEOUT=5000
SMTP_WRITE_TIMEOUT=5000
MAIL_FROM=
